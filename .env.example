# ---------------------------------------------------------------------------
# JobGraph - environment configuration
# Copy this file to `.env` in the same folder (project root) and fill in your
# own CognoDB credentials. Never commit the real `.env` file.
# ---------------------------------------------------------------------------

# CognoDB (Bolt-compatible, Neo4j-driver-compatible) connection details.
# CognoDB gives you a URI that looks like: bolt+s://<instance-id>.databases.cognodb.cloud
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-password>

# Optional: name of the database to connect to (CognoDB/Neo4j default is "neo4j")
COGNODB_DATABASE=neo4j

# Server
PORT=4000
NODE_ENV=development

# Client (Vite) - base URL the frontend uses to reach the API
VITE_API_BASE_URL=http://localhost:4000/api
